{
  "name": "nav-erp-hemsida",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync-content.ts",
    "screenshots": "tsx scripts/optimize-screenshots.ts",
    "predev": "npm run sync && npm run screenshots",
