  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "0.469.0",
    "marked": "^18.1.1",
    "next": "16.2.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
